# Phase 3 - MACHINE 1: DB1 Retail POS, DB2 Distributor ERP, and the coordinator.
#
#   cp deploy/machine1.env.example deploy/machine1.env     (deploy/machine*.env is git-ignored)
#   then replace every <...> value. Use the SAME four tokens on both machines.
#
# MACHINE1_IP / MACHINE2_IP: each machine's LAN address
#   Windows: ipconfig  (IPv4 Address)    macOS: ipconfig getifaddr en0    Linux: hostname -I

ASALI_FEDERATION=remote
ASALI_NODE_BIND=0.0.0.0
ASALI_MACHINE_LABEL=machine1
ASALI_STRICT_ISOLATION=1
ASALI_NODE_TIMEOUT_SEC=5

# Where the coordinator reaches each database. DB1/DB2 are on this machine;
# DB3/DB4 are on Machine 2 and MUST use Machine 2's LAN address.
ASALI_DB1_URL=http://<MACHINE1_IP>:8021
ASALI_DB2_URL=http://<MACHINE1_IP>:8022
ASALI_DB3_URL=http://<MACHINE2_IP>:8023
ASALI_DB4_URL=http://<MACHINE2_IP>:8024
ASALI_DB1_MACHINE=machine1
ASALI_DB2_MACHINE=machine1
ASALI_DB3_MACHINE=machine2
ASALI_DB4_MACHINE=machine2

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
ASALI_DB1_TOKEN=<DB1_TOKEN>
ASALI_DB2_TOKEN=<DB2_TOKEN>
ASALI_DB3_TOKEN=<DB3_TOKEN>
ASALI_DB4_TOKEN=<DB4_TOKEN>

ASALI_COORDINATOR_BIND=0.0.0.0
ASALI_COORDINATOR_PORT=8030
# Optional: require a token on the coordinator's /api/v3 endpoints too
# ASALI_COORDINATOR_TOKEN=<COORDINATOR_TOKEN>
