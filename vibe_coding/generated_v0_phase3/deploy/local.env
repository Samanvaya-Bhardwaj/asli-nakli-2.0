# Phase 3 - LOCAL SIMULATION profile: all four database services and the
# coordinator on THIS machine, as separate processes with separate data
# directories, talking HTTP over the loopback interface.
#
# This proves process and data isolation, not multi-machine execution.
# For two machines use deploy/machine1.env and deploy/machine2.env.
#
# The tokens below are development placeholders for loopback use only.

ASALI_FEDERATION=remote
ASALI_NODE_BIND=127.0.0.1
ASALI_MACHINE_LABEL=local-simulation
ASALI_STRICT_ISOLATION=1
ASALI_NODE_TIMEOUT_SEC=4

ASALI_DB1_URL=http://127.0.0.1:8021
ASALI_DB2_URL=http://127.0.0.1:8022
ASALI_DB3_URL=http://127.0.0.1:8023
ASALI_DB4_URL=http://127.0.0.1:8024
ASALI_DB1_MACHINE=local-simulation
ASALI_DB2_MACHINE=local-simulation
ASALI_DB3_MACHINE=local-simulation
ASALI_DB4_MACHINE=local-simulation

ASALI_DB1_TOKEN=dev-only-db1-loopback
ASALI_DB2_TOKEN=dev-only-db2-loopback
ASALI_DB3_TOKEN=dev-only-db3-loopback
ASALI_DB4_TOKEN=dev-only-db4-loopback

ASALI_COORDINATOR_BIND=127.0.0.1
ASALI_COORDINATOR_PORT=8030
