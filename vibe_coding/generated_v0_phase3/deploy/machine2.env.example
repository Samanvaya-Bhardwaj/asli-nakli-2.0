# Phase 3 - MACHINE 2: DB3 Manufacturer Registry and DB4 Ministry Reports.
#
#   cp deploy/machine2.env.example deploy/machine2.env     (git-ignored)
#   then replace every <...> value with the SAME tokens as Machine 1.
#
# Machine 2 runs no coordinator, so it needs only its own two services' ports and tokens.

ASALI_NODE_BIND=0.0.0.0
ASALI_MACHINE_LABEL=machine2
ASALI_STRICT_ISOLATION=1

ASALI_DB3_PORT=8023
ASALI_DB4_PORT=8024
ASALI_DB3_TOKEN=<DB3_TOKEN>
ASALI_DB4_TOKEN=<DB4_TOKEN>
